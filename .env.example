# Copy to .env and replace the placeholders. Never commit .env.

# --- PostgreSQL (docker compose) ---
POSTGRES_DB=bloome
POSTGRES_USER=bloome
POSTGRES_PASSWORD=monstax2015
POSTGRES_PORT=5432

# --- Backend (also usable as plain environment variables when running with Maven) ---
DB_URL=jdbc:postgresql://localhost:5432/bloome
DB_USERNAME=bloome
DB_PASSWORD=monstax2015

# Exact origin(s) of the web app, comma separated (no wildcards).
CORS_ALLOWED_ORIGINS=http://localhost:4200
# true in production (HTTPS only).
SESSION_COOKIE_SECURE=false
SESSION_TIMEOUT=8h
AUTH_RATE_LIMIT_PER_MINUTE=10

# Demo catalog: keep db/seed for development; production: classpath:db/migration only.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/seed

# Administrator created at startup if both are set (password >= 12 characters).
BLOOME_ADMIN_EMAIL=
BLOOME_ADMIN_PASSWORD=

# Development-only demo accounts (see README). NEVER true in production.
BLOOME_DEMO_ACCOUNTS=true

# --- Integration tests (mvn test) ---
TEST_DB_URL=jdbc:postgresql://localhost:5432/bloome_test
TEST_DB_USERNAME=bloome
TEST_DB_PASSWORD=change-me-local-db-password
